# Card Cloner - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs

# ============================================
# CLÉS API REQUISES
# ============================================

# OpenAI API Key (pour GPT-4 Vision)
# Obtenez votre clé sur: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (pour Claude 3.5 Sonnet)
# Obtenez votre clé sur: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ============================================
# OPTIONNEL - Supabase (stockage persistant)
# ============================================

# URL de votre projet Supabase
SUPABASE_URL=https://your-project.supabase.co

# Clé anon/public de Supabase
SUPABASE_KEY=your-supabase-anon-key

# ============================================
# OPTIONNEL - Vectorizer.ai (vectorisation de logos)
# ============================================

# API Key Vectorizer.ai
# Obtenez votre clé sur: https://vectorizer.ai/
VECTORIZER_API_KEY=your-vectorizer-key

# ============================================
# CONFIGURATION SERVEUR
# ============================================

# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Nombre maximum de boucles de correction
MAX_CORRECTION_LOOPS=3

